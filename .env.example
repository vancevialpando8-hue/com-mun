# Supabase project settings. Keep the service-role key server-only and never expose it as NEXT_PUBLIC_*.
SUPABASE_URL=https://jpxyvskyfpaqwtelntuw.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-the-com-mun-service-role-key
# Use a dedicated random secret in production. The service key is only a fallback for existing deployments.
WALLET_COOKIE_SECRET=replace-with-a-random-session-secret
# Keep false unless a trusted ChatGPT auth gateway strips/validates this header before it reaches the Worker.
ALLOW_UNVERIFIED_CHATGPT_HEADER=false

# Railway sets PORT automatically. This is useful for local Node runs.
PORT=3000
